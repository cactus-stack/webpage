{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Matches the Worker that Cloudflare Workers Builds created when the
  // GitHub repo was connected (named after the repo, "webpage"). The
  // *.workers.dev subdomain name is cosmetic; the real domain served is
  // the custom domain route below.
  "name": "webpage",
  "compatibility_date": "2026-09-15",

  // Assets-only Worker: there is no server-side entrypoint, the exported
  // Next.js site is served directly from Cloudflare's edge.
  "assets": {
    "directory": "./out",
    // Serve the exported not-found page for unknown paths.
    "not_found_handling": "404-page"
  },

  "routes": [
    {
      "pattern": "oscarbucio.dev",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  }
}
